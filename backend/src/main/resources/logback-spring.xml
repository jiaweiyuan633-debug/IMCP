<?xml version="1.0" encoding="UTF-8"?>
<!-- 可观测性日志配置：控制台 + 滚动文件 + JSON 结构化日志（Loki/ELK 采集）。
     dev 控制台人类可读；prod 控制台输出 JSON 单行结构化日志，
     由容器运行时 + promtail(Loki)/filebeat(ELK)/fluent-bit 直接采集，无需挂载日志卷。
     另输出滚动 JSON 文件保留全量历史，滚动策略控制体积与保留期。 -->
<configuration>
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="admin-backend"/>
    <property name="LOG_PATH" value="${LOG_PATH:-logs}"/>

    <!-- 控制台（dev/默认）：人类可读，保留 requestId 便于会话追踪 -->
    <springProfile name="!prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-}] %logger{40} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>

    <!-- 控制台（prod）：LogstashEncoder 输出含 MDC(requestId/traceId/spanId) 的单行 JSON，
         一行一条事件，容器 stdout 即结构化，供 Loki/Kibana 全文检索、过滤与告警 -->
    <springProfile name="prod">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <customFields>{"app":"${appName}"}</customFields>
                <includeMdc>true</includeMdc>
                <includeCallerData>false</includeCallerData>
            </encoder>
        </appender>
    </springProfile>

    <!-- 滚动文件：全量日志，按日+大小切分、压缩归档 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/admin.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/admin.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>15</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%X{requestId:-}] [%X{traceId:-},%X{spanId:-}] %logger{40} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- JSON 结构化日志：LogstashEncoder 输出含 MDC(requestId/traceId/spanId) 的单行 JSON，
         一行一条事件，供 Grafana 日志面板（Loki）与 Kibana（ELK）全文检索、过滤与告警 -->
    <appender name="JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/admin-json.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/admin-json.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>15</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"app":"${appName}"}</customFields>
            <includeMdc>true</includeMdc>
            <includeCallerData>false</includeCallerData>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="JSON"/>
    </root>
</configuration>
