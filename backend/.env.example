TOTP_ENCRYPTION_KEY=
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7
CALLBACK_BASE_URL=http://127.0.0.1:8080
AI_BASE_URL=
AI_SCAN_INTERVAL_MS=30000

