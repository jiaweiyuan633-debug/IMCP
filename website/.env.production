# 官网生产环境配置（演示模式占位：默认全部留空 = 演示站点行为）。
# 上线时由部署侧填写真实值（可在此提交或由 CI/编排注入同名变量覆盖）；
# 留空时的降级行为由 src/App.vue 与 src/analytics.ts 定义，保证不渲染虚构联系方式、
# 不假装表单提交成功、不加载第三方埋点脚本。

# 预约表单线索提交端点（如 https://api.example.com/api/v1/leads）。
# 留空：表单禁用并提示"演示模式，表单未启用"。
VITE_LEAD_ENDPOINT=

# 官网对外联系方式；留空则不渲染（避免虚构占位曝光）。
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=

# 页脚与版权展示的企业名；留空回退产品名"智能管理平台"。
VITE_COMPANY_NAME=

# 埋点：GA4 Measurement ID（如 G-XXXXXXXXXX）或 GTM Container ID（如 GTM-XXXXXXX）。
# 留空：analytics.ts no-op，不加载 googletagmanager 脚本。
# 注意：启用后需同步放宽 nginx.conf 的 CSP（script-src/connect-src 追加
# https://www.googletagmanager.com https://www.google-analytics.com）。
VITE_GA_ID=
VITE_GTM_ID=
