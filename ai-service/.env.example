APP_NAME=ai-service
REDIS_URL=redis://localhost:6379/0
# AI 服务鉴权密钥：与后端 AiServiceConfig.apiKey 保持一致（入站 Bearer 鉴权）
# 必填：代码中无默认值，未注入即启动失败（fail-fast）。本地开发显式使用此模板值；
# 生产必须由 k8s Secret 注入（Helm --set secret.aiAuthToken）。
AUTH_TOKEN=dev-ai-service-token
# 出站回调签名密钥（可选）：后端当前仍用同一共享 apiKey 做入站 Bearer 与回调
# HMAC 验签，为保持跨端契约本项默认留空 → 回调签名沿用 AUTH_TOKEN（见代码注释中
# 的风险说明）。后端拆分独立验签密钥后，在此注入新键并同步后端配置即可轮换。
CALLBACK_HMAC_KEY=
DEFAULT_TIMEOUT_SECONDS=60

# 单任务超时上限（秒）：超过默认值 clamp，保证任何任务最长执行可控
MAX_TIMEOUT_SECONDS=3600
# 回调 SSRF 白名单（JSON 数组）：生产必须显式注入，如 ["http://admin-backend:8080"]
CALLBACK_ALLOWED_ORIGINS=[]
# LLM 提供方（JSON 字符串）：{"deepseek": {"base_url": "...", "api_key": "sk-xxx",
#   "model": "...", "embedding_model": "..."}}
# 单条结构经 pydantic 校验（base_url 必填等）；留空则使用 mock 提供方（联调用）。
# 生产必须配置真实 provider 并把 LLM_FAIL_FAST=true，否则静默跑假数据
LLM_PROVIDERS={}
LLM_DEFAULT_PROVIDER=mock
# 生产防呆：默认提供方为 mock 且本项为 true 时启动失败（防生产静默跑 mock）
LLM_FAIL_FAST=false
# 工作协程数（每副本）
WORKER_COUNT=2
# OCR 提供方：mock / tesseract；tesseract 不可用时默认回退 mock 并告警，
# OCR_FAIL_FAST=true 则直接抛错（生产期望真实 OCR 时开启）
OCR_PROVIDER=mock
OCR_FAIL_FAST=false

# PII 出域脱敏服务端强制开关：对接真实 LLM/Embedding 的生产必须置 true——
# 开启后即使客户端传 mask_pii=false，发给外部 provider 的文本也会先脱敏
# （mock 等进程内提供方豁免，本地联调不受影响）
PII_MASK_REQUIRED=false

# Redis 客户端零超时：socket 连接/命令超时（秒）+ 空闲连接健康检查间隔（秒）。
# 默认不加时，Redis 断连/卡死会让 worker、调度与探活永久阻塞
REDIS_SOCKET_CONNECT_TIMEOUT=5.0
REDIS_SOCKET_TIMEOUT=5.0
REDIS_HEALTH_CHECK_INTERVAL=30.0
# CPU 密集不可中断工作（OCR/PDF/KMeans/训练）的有界线程池并发上限
CPU_THREAD_POOL_SIZE=4
# 全局请求体大小上限（字节），超出返回 413
MAX_REQUEST_BODY_BYTES=8388608
# 精确余弦检索的命名空间向量数上限（超限拒绝检索并提示换专用向量库）
VECTOR_SEARCH_MAX_VECTORS=50000
