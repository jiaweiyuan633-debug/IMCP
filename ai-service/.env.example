APP_NAME=ai-service
REDIS_URL=redis://localhost:6379/0
# AI 服务鉴权密钥：与后端 AiServiceConfig.apiKey 保持一致（入站 Bearer + 出站回调 HMAC）
# 必填：代码中无默认值，未注入即启动失败（fail-fast）。本地开发显式使用此模板值；
# 生产必须由 k8s Secret 注入（Helm --set secret.aiAuthToken）。
AUTH_TOKEN=dev-ai-service-token
DEFAULT_TIMEOUT_SECONDS=60

# 批次3（R4-1.49）新增配置：
# 单任务超时上限（秒）：超过默认值 clamp，保证任何任务最长执行可控
MAX_TIMEOUT_SECONDS=3600
# 回调 SSRF 白名单（JSON 数组）：生产必须显式注入，如 ["http://admin-backend:8080"]
CALLBACK_ALLOWED_ORIGINS=[]
# LLM 提供方（JSON 字符串）：{"deepseek": {"base_url": "...", "api_key": "sk-xxx", "model": "..."}}
# 留空则使用 mock 提供方（联调用；生产必须配置真实 provider，否则静默跑假数据）
LLM_PROVIDERS={}
LLM_DEFAULT_PROVIDER=mock
# 工作协程数（每副本）
WORKER_COUNT=2
# OCR 提供方：mock / tesseract；tesseract 不可用时默认回退 mock 并告警，
# OCR_FAIL_FAST=true 则直接抛错（生产期望真实 OCR 时开启）
OCR_PROVIDER=mock
OCR_FAIL_FAST=false
